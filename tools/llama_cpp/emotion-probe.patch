+    static bool riko_probe_eval(ggml_tensor * tensor, bool ask, void * data) {
+        auto * self = static_cast<server_context_impl *>(data);
+        const bool capture = self->riko_probe_armed && std::strcmp(tensor->name, "result_norm") == 0;
+        if (ask) {
+            return capture;
+        }
+        if (!capture || tensor->type != GGML_TYPE_F32 || tensor->ne[0] < 1 || tensor->ne[0] > 65536 ||
+                tensor->ne[1] != 1 || tensor->ne[2] != 1 || tensor->ne[3] != 1 || tensor->nb[0] != sizeof(float)) {
+            return true;
+        }
+        const int width = (int) tensor->ne[0];
+        std::vector<float> row(width);
+        ggml_backend_tensor_get(tensor, row.data(), 0, width * sizeof(float));
+        std::vector<float> features(256);
+        for (int i = 0; i < 256; ++i) {
+            const int first = i * width / 256;
+            const int last = ((i + 1) * width + 255) / 256;
+            double sum = 0;
+            for (int j = first; j < last; ++j) {
+                if (!std::isfinite(row[j])) {
+                    return true;
+                }
+                sum += row[j];
+            }
+            features[i] = (float) (sum / (last - first));
+        }
+        self->riko_probe_features = std::move(features);
+        return true;
+    }
 
