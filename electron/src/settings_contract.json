{
 "about": "The checks across settings and the provider visibility /api/settings returns (configuration/schema.py rules() and field()'s visible_when), with cases the renderer (settings_model.mjs ruleErrors, fieldRelevant) and the backend (kernel/schema.py Rule.broken, schema.visible) must judge alike. tests/test_electron_settings.py checks it against the backend: regenerate the rules when they change.",
 "rules": [
  {"path": "runtime.n_ubatch", "message": "runtime.n_ubatch must not exceed n_batch", "when": {"runtime.provider": ["llama_cpp"]}, "at_most": "runtime.n_batch"},
  {"path": "runtime.type_v", "message": "Quantized runtime.type_v requires flash_attn auto or on", "when": {"runtime.provider": ["llama_cpp"], "runtime.type_v": ["q8_0", "q4_0", "q4_1", "q5_0", "q5_1", "iq4_nl"]}, "one_of": {"runtime.flash_attn": ["auto", "on"]}},
  {"path": "runtime.hf_repo_id", "message": "llama_cpp requires runtime.model_path or both hf_repo_id and hf_filename", "when": {"runtime.provider": ["llama_cpp"]}, "any_set": [["runtime.model_path"], ["runtime.hf_repo_id", "runtime.hf_filename"]]},
  {"path": "speech.split_window_words", "message": "speech.split_window_words cannot exceed speech.max_words", "at_most": "speech.max_words"},
  {"path": "voice.transcription_gap_seconds", "message": "voice.transcription_gap_seconds must be shorter than voice.utterance_end_seconds", "below": "voice.utterance_end_seconds"}
 ],
 "rule_cases": [
  {"inputs": {"runtime.provider": "llama_cpp", "runtime.model_path": "model.gguf", "runtime.hf_repo_id": null, "runtime.hf_filename": null, "runtime.n_batch": 512, "runtime.n_ubatch": 512, "runtime.type_v": "q8_0", "runtime.flash_attn": "auto", "speech.max_words": 20, "speech.split_window_words": 10, "voice.transcription_gap_seconds": 0.5, "voice.utterance_end_seconds": 1.0}, "errors": []},
  {"inputs": {"runtime.provider": "llama_cpp", "runtime.model_path": "", "runtime.hf_repo_id": "owner/model", "runtime.hf_filename": "", "runtime.n_batch": 128, "runtime.n_ubatch": 256, "runtime.type_v": "q8_0", "runtime.flash_attn": "off", "speech.max_words": 20, "speech.split_window_words": 10, "voice.transcription_gap_seconds": 0.5, "voice.utterance_end_seconds": 1.0}, "errors": ["runtime.hf_repo_id", "runtime.n_ubatch", "runtime.type_v"]},
  {"inputs": {"runtime.provider": "openai", "runtime.model_path": "", "runtime.hf_repo_id": "owner/model", "runtime.hf_filename": "", "runtime.n_batch": 128, "runtime.n_ubatch": 256, "runtime.type_v": "q8_0", "runtime.flash_attn": "off", "speech.max_words": 20, "speech.split_window_words": 10, "voice.transcription_gap_seconds": 0.5, "voice.utterance_end_seconds": 1.0}, "errors": []},
  {"inputs": {"runtime.provider": "llama_cpp", "runtime.model_path": "", "runtime.hf_repo_id": "owner/model", "runtime.hf_filename": "model-Q4_K_M.gguf", "runtime.n_batch": 128, "runtime.n_ubatch": 256, "runtime.type_v": "f16", "runtime.flash_attn": "off", "speech.max_words": 20, "speech.split_window_words": 10, "voice.transcription_gap_seconds": 0.5, "voice.utterance_end_seconds": 1.0}, "errors": ["runtime.n_ubatch"]},
  {"inputs": {"runtime.provider": "llama_cpp", "runtime.model_path": "model.gguf", "runtime.hf_repo_id": null, "runtime.hf_filename": null, "runtime.n_batch": 128, "runtime.n_ubatch": null, "runtime.type_v": "q8_0", "runtime.flash_attn": "auto", "speech.max_words": 20, "speech.split_window_words": 10, "voice.transcription_gap_seconds": 0.5, "voice.utterance_end_seconds": 1.0}, "errors": []},
  {"inputs": {"runtime.provider": "llama_cpp", "runtime.model_path": "model.gguf", "runtime.hf_repo_id": null, "runtime.hf_filename": null, "runtime.n_batch": 512, "runtime.n_ubatch": 512, "runtime.type_v": "q8_0", "runtime.flash_attn": "auto", "speech.max_words": 20, "speech.split_window_words": 21, "voice.transcription_gap_seconds": 1.0, "voice.utterance_end_seconds": 1.0}, "errors": ["speech.split_window_words", "voice.transcription_gap_seconds"]}
 ],
 "visible_when": {
  "runtime.provider": null,
  "runtime.n_ctx": null,
  "runtime.n_ubatch": {"runtime.provider": ["llama_cpp"]},
  "runtime.model_path": {"runtime.provider": ["llama_cpp"]},
  "runtime.parallel_slots": {"runtime.provider": ["llama_cpp", "llama_server"]},
  "runtime.base_url": {"runtime.provider": ["llama_server", "lm_studio", "openai", "openai_compatible", "ollama", "local_http"]},
  "runtime.model": {"runtime.provider": ["lm_studio", "openai", "openai_compatible", "ollama", "local_http"]},
  "runtime.api_mode": {"runtime.provider": ["lm_studio", "openai", "openai_compatible", "ollama", "local_http"]}
 },
 "visible": {
  "llama_cpp": ["runtime.provider", "runtime.n_ctx", "runtime.n_ubatch", "runtime.model_path", "runtime.parallel_slots"],
  "llama_server": ["runtime.provider", "runtime.n_ctx", "runtime.parallel_slots", "runtime.base_url"],
  "openai": ["runtime.provider", "runtime.n_ctx", "runtime.base_url", "runtime.model", "runtime.api_mode"],
  "ollama": ["runtime.provider", "runtime.n_ctx", "runtime.base_url", "runtime.model", "runtime.api_mode"]
 }
}
