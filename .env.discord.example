# Copy these entries to the repository's .env. Never commit a real token.
Discord_bot_token=
Discord_admins=123456789012345678
# Additional trusted users share the companion's memory/history and local tools.
Discord_allowed_users=
# Explicit server TEXT channel IDs; an empty list disables server interaction.
# DMs are allowed only for configured admins/trusted users.
Discord_Channel_whitelist=234567890123456789
Discord_backend_url=http://127.0.0.1:8765
# Optional test server for immediate slash-command synchronization.
Discord_sync_guild=
# Calling is paused; no FFmpeg, voice extension, camera, ASR or TTS is needed by the bot.
